rules_version = '2';

// SECURITY MODEL — server-only access.
//
// This app reads and writes Firestore EXCLUSIVELY through server-side API routes
// that use the Firebase Admin SDK (see lib/firebase-admin.ts). The Admin SDK
// bypasses these rules entirely. No browser/client code ever uses the Firestore
// client SDK (verified 2026-06-03), so the safe and correct posture is to deny
// ALL direct client access. This prevents anyone from using the public web API
// keys (NEXT_PUBLIC_FIREBASE_*) to read or write data outside the app's own
// authenticated, access-controlled server routes.
//
// If you ever add genuine client-side Firestore reads/writes, replace the
// deny-all below with scoped rules — do NOT loosen this to test mode.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
